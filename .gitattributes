# Normalize text files; keep Unity YAML merge-friendly.
* text=auto
*.cs text eol=lf diff=csharp
*.sh text eol=lf
*.unity text eol=lf
*.prefab text eol=lf
*.asset text eol=lf
*.meta text eol=lf
*.mat text eol=lf
*.anim text eol=lf
*.controller text eol=lf

# Binary assets (small, so stored directly in git rather than LFS)
*.png binary
*.jpg binary
*.wav binary
*.ogg binary
*.mp3 binary
*.ttf binary
*.otf binary
